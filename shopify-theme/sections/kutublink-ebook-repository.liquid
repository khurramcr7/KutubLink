{% stylesheet %}
  @keyframes klFloatBook {
    0%, 100% { transform: perspective(950px) rotateY(-14deg) rotateX(4deg) translateY(0); }
    50% { transform: perspective(950px) rotateY(-10deg) rotateX(6deg) translateY(-12px); }
  }
  .kl-ebooks {
    padding: clamp(64px, 7vw, 100px) 5vw;
    background: #070709;
    color: #fafafa;
    border-top: 2px solid #facc15;
    border-bottom: 2px solid #facc15;
  }
  .kl-ebooks * { box-sizing: border-box; }
  .kl-ebooks__shell {
    width: min(1280px, 100%);
    margin-inline: auto;
  }
  .kl-ebooks__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 32px;
    flex-wrap: wrap;
    margin-bottom: 48px;
    padding-bottom: 24px;
    border-bottom: 1px solid #22222b;
  }
  .kl-ebooks__kicker {
    margin: 0 0 10px;
    color: #facc15;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .kl-ebooks h2 {
    margin: 0 0 12px;
    color: #ffffff;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(32px, 4vw, 52px);
    line-height: 1.05;
    font-weight: 500;
  }
  .kl-ebooks__sub {
    margin: 0;
    color: #a1a1aa;
    font-size: 15px;
    line-height: 1.7;
    max-width: 660px;
  }
  .kl-ebooks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .kl-ebooks__actions a {
    padding: 13px 20px;
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    border-radius: 8px;
  }
  .kl-btn-yellow {
    background: #facc15;
    color: #070709;
  }
  .kl-btn-outline {
    border: 1px solid #facc15;
    color: #facc15;
  }
  .kl-ebooks__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .kl-float-card {
    background: #0e0e13;
    border: 1px solid #24242e;
    border-radius: 16px;
    padding: 26px 20px 22px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: border-color 0.25s ease, box-shadow 0.25s ease;
  }
  .kl-float-card:hover {
    border-color: #facc15;
    box-shadow: 0 16px 40px rgba(250, 204, 21, 0.12);
  }
  .kl-book-stage {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-bottom: 18px;
  }
  .kl-book-3d {
    width: 206px;
    height: 294px;
    position: relative;
    border-radius: 4px 10px 10px 4px;
    background: linear-gradient(150deg, #16161e 0%, #09090c 100%);
    border: 2px solid #facc15;
    box-shadow: -12px 16px 28px rgba(0, 0, 0, 0.9), 0 0 26px rgba(250, 204, 21, 0.14);
    padding: 16px 16px 16px 22px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    animation: klFloatBook 5.4s ease-in-out infinite;
  }
  .kl-book-3d::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 14px;
    background: linear-gradient(90deg, rgba(250,204,21,0.38), transparent);
    border-right: 1px solid rgba(250,204,21,0.35);
  }
  .kl-book-3d::after {
    content: "";
    position: absolute;
    top: 4px;
    bottom: 4px;
    right: -8px;
    width: 8px;
    background: repeating-linear-gradient(90deg, #e4e4e7 0px, #a1a1aa 2px, #18181b 3px);
    border-radius: 0 2px 2px 0;
    transform: skewY(2deg);
  }
  .kl-book-top {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 800;
    color: #facc15;
    border-bottom: 1px solid rgba(250,204,21,0.28);
    padding-bottom: 6px;
  }
  .kl-book-center {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    margin: auto 0;
  }
  .kl-book-center small {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
    color: #a1a1aa;
  }
  .kl-book-center strong {
    font-family: 'Amiri', Georgia, serif;
    font-size: 25px;
    line-height: 1.25;
    color: #facc15;
  }
  .kl-book-center i {
    width: 36px;
    height: 2px;
    background: #facc15;
    display: block;
  }
  .kl-book-center b {
    font-family: Georgia, serif;
    font-size: 16px;
    color: #ffffff;
    font-weight: 600;
  }
  .kl-book-foot {
    font-family: 'Amiri', Georgia, serif;
    font-size: 13px;
    color: #d4d4d8;
    border-top: 1px solid rgba(250,204,21,0.28);
    padding-top: 6px;
  }
  .kl-book-glow {
    margin-top: 16px;
    width: 155px;
    height: 14px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(250,204,21,0.45) 0%, rgba(250,204,21,0) 75%);
    filter: blur(5px);
  }
  .kl-badge {
    display: inline-block;
    padding: 4px 10px;
    border-radius: 99px;
    background: rgba(250,204,21,0.14);
    border: 1px solid rgba(250,204,21,0.4);
    color: #facc15;
    font-size: 10px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .kl-card-info h3 {
    margin: 10px 0 6px;
    font-family: Georgia, serif;
    font-size: 19px;
    color: #ffffff;
    font-weight: 600;
  }
  .kl-card-info p {
    margin: 0 0 14px;
    font-size: 12.5px;
    color: #a1a1aa;
    line-height: 1.5;
  }
  .kl-dl-row {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 6px;
    width: 100%;
  }
  .kl-dl-row a {
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 10.5px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
  }
  .kl-dl-yellow {
    background: #facc15;
    color: #070709;
  }
  .kl-dl-dark {
