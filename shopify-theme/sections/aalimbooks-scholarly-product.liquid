{% comment %}
  Aalimbooks Scholarly Product Page Section (aalimbooks-scholarly-product.liquid)
  Brings the full depth of the Aalimbooks Prototype + KutubLink + Dars-e-Nizami Curriculum
  + Multi-Spread Look-Inside Gallery & Structured Bibliographic Ledger into Shopify.
{% endcomment %}

{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign sku = current_variant.sku | default: '' | strip
  assign sku_up = sku | upcase

  comment
    Automatic Bilingual Title Split (English H1 + RTL Arabic/Urdu H2)
    Splits on the first Arabic/Urdu Unicode character or uses metafields if present.
  endcomment
  assign raw_title = product.title | strip
  assign title_en = product.metafields.custom.title_en | default: ''
  assign title_ar = product.metafields.custom.title_ar | default: ''

  if title_en == '' and title_ar == ''
    assign words = raw_title | split: ' '
    assign en_parts = ''
    assign ar_parts = ''
    assign in_arabic = false
    for w in words
      assign first_char = w | slice: 0, 1
      if first_char >= '؀' and first_char <= 'ۿ'
        assign in_arabic = true
      elsif first_char >= 'ݐ' and first_char <= 'ݿ'
        assign in_arabic = true
      elsif first_char >= 'ﭐ' and first_char <= 'ﻼ'
        assign in_arabic = true
      endif
      if in_arabic
        assign ar_parts = ar_parts | append: ' ' | append: w
      else
        assign en_parts = en_parts | append: ' ' | append: w
      endif
    endfor
    assign title_en = en_parts | strip
    assign title_ar = ar_parts | strip
    if title_en == ''
      assign title_en = raw_title
    endif
  endif

  comment
    Automatic Dars-e-Nizami Curriculum Grade (1-8) Mapping for all 54 prescribed works
  endcomment
  assign dars_badge = ''
  assign dars_ar = ''
  case sku_up
    when 'AB-1186', 'AB-1247', 'AB-99', 'AB-100'
      assign dars_badge = 'Dars-e-Nizami · Grade 1 · Ilm al-Sarf'
      assign dars_ar = 'علم الصرف'
    when 'AB-1238', 'AB-101'
      assign dars_badge = 'Dars-e-Nizami · Grade 1 · Ilm al-Nahw'
      assign dars_ar = 'علم النحو'
    when 'AB-1189'
      assign dars_badge = 'Dars-e-Nizami · Grade 1 · Iqna al-Zamir'
      assign dars_ar = 'إقناع الضمير'
    when 'AB-960', 'AB-757', 'AB-206', 'AB-278'
      assign dars_badge = 'Dars-e-Nizami · Grade 1 · Noorani Qaida'
      assign dars_ar = 'نوراني قاعده'
    when 'AB-1095', 'AB-85', 'AB-1202', 'AB-404'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · Mukhtasar al-Quduri'
      assign dars_ar = 'مختصر القدوري'
    when 'AB-88', 'AB-360'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · Zad al-Talibin'
      assign dars_ar = 'زاد الطالبين'
    when 'AB-768'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · Ilm al-Sighah'
      assign dars_ar = 'علم الصيغة'
    when 'AB-92', 'AB-1022', 'AB-1249'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · Taysir al-Mantiq'
      assign dars_ar = 'تيسير المنطق'
    when 'AB-91'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · Isaghuji'
      assign dars_ar = 'إيساغوجي'
    when 'AB-608', 'AB-1009'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · Khasiyyat al-Abwab'
      assign dars_ar = 'خاصيات الأبواب'
    when 'AB-89', 'AB-1001', 'AB-1199'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · al-Mirqat (Logic)'
      assign dars_ar = 'المرقاة في المنطق'
    when 'AB-708', 'AB-1263', 'AB-1264'
      assign dars_badge = 'Dars-e-Nizami · Grade 2 · al-Fawaid al-Makkiyyah'
      assign dars_ar = 'الفوائد المكية'
    when 'AB-1240', 'AB-1206'
      assign dars_badge = 'Dars-e-Nizami · Grade 3 · Kanz al-Daqa’iq'
      assign dars_ar = 'كنز الدقائق'
    when 'AB-1098'
      assign dars_badge = 'Dars-e-Nizami · Grade 3 · Nafhat al-Arab'
      assign dars_ar = 'نفحة العرب'
    when 'AB-1135', 'AB-1272'
      assign dars_badge = 'Dars-e-Nizami · Grade 3 · Usul al-Shashi'
      assign dars_ar = 'أصول الشاشي'
    when 'AB-880', 'AB-520', 'AB-843'
      assign dars_badge = 'Dars-e-Nizami · Grade 3 · al-Kafiyah'
      assign dars_ar = 'الكافية في النحو'
    when 'AB-1293', 'AB-1200'
      assign dars_badge = 'Dars-e-Nizami · Grade 4 · Nur al-Anwar'
      assign dars_ar = 'نور الأنوار'
    when 'AB-1274'
      assign dars_badge = 'Dars-e-Nizami · Grade 4 · Maqamat al-Hariri'
      assign dars_ar = 'مقامات الحريري'
    when 'AB-1227', 'AB-1208'
      assign dars_badge = 'Dars-e-Nizami · Grade 4 · Sharh al-Wiqayah'
      assign dars_ar = 'شرح الوقاية'
    when 'AB-1151', 'SRJ-001'
      assign dars_badge = 'Dars-e-Nizami · Grade 4 · Riyad al-Salihin'
      assign dars_ar = 'رياض الصالحين'
    when 'AB-1288'
      assign dars_badge = 'Dars-e-Nizami · Grade 4 · Durus al-Balaghah'
      assign dars_ar = 'دروس البلاغة'
    when 'AB-1205', 'SRJ-018', 'SRJ-032'
      assign dars_badge = 'Dars-e-Nizami · Grade 4 · Sharh al-Jami'
      assign dars_ar = 'شرح الجامي'
    when 'AB-1225', 'AB-1228', 'AB-1250'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · al-Hidayah — Part 1'
      assign dars_ar = 'الهداية — الجزء الأول'
    when 'AB-1000', 'AB-1260'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · al-Mu’allaqat al-Sab’'
      assign dars_ar = 'المعلقات السبع'
    when 'AB-1192'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · Athar al-Sunan'
      assign dars_ar = 'آثار السنن'
    when 'AB-1345'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · Diwan al-Mutanabbi'
      assign dars_ar = 'ديوان المتنبي'
    when 'AB-1350', 'AB-235'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · al-Intibahat al-Mufidah'
      assign dars_ar = 'الانتباهات المفيدة'
    when 'AB-1164', 'AB-1187'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · al-Husami'
      assign dars_ar = 'الحسامي'
    when 'AB-64'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · Mu’in al-Falsafah'
      assign dars_ar = 'معين الفلسفة'
    when 'AB-1221'
      assign dars_badge = 'Dars-e-Nizami · Grade 5 · Mukhtasar al-Ma’ani'
      assign dars_ar = 'مختصر المعاني'
    when 'AB-1226', 'AB-1229', 'AB-1251'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · al-Hidayah — Part 2'
      assign dars_ar = 'الهداية — الجزء الثاني'
    when 'AB-1290', 'AB-1159', 'AB-1207', 'SRJ-004'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · Tafsir al-Jalalayn'
      assign dars_ar = 'تفسير الجلالين'
    when 'AB-1224'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · Diwan al-Hamasah'
      assign dars_ar = 'ديوان الحماسة'
    when 'AB-1142'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · Musnad al-Imam al-A’zam'
      assign dars_ar = 'مسند الإمام الأعظم'
    when 'AB-1275', 'AB-883'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · Sharh al-Aqa’id al-Nasafiyyah'
      assign dars_ar = 'شرح العقائد النسفية'
    when 'AB-1363'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · al-Tawdih wa-al-Talwih'
      assign dars_ar = 'التوضيح والتلويح'
    when 'AB-447', 'AB-1118', 'AB-1144', 'AB-1190', 'AB-896'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · al-Siraji (Inheritance Law)'
      assign dars_ar = 'السراجي في الميراث'
    when 'AB-51', 'AB-910'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · Matn al-Aqidah al-Tahawiyyah'
      assign dars_ar = 'متن العقيدة الطحاوية'
    when 'AB-57'
      assign dars_badge = 'Dars-e-Nizami · Grade 6 · Matn al-Kafi'
      assign dars_ar = 'متن الكافي'
    when 'AB-1252', 'AB-1268', 'AB-1282'
      assign dars_badge = 'Dars-e-Nizami · Grade 7 · al-Hidayah — Part 3'
      assign dars_ar = 'الهداية — الجزء الثالث'
    when 'AB-1195'
      assign dars_badge = 'Dars-e-Nizami · Grade 7 · al-Fawz al-Kabir'
      assign dars_ar = 'الفوز الكبير'
    when 'AB-1300'
      assign dars_badge = 'Dars-e-Nizami · Grade 7 · Tafsir al-Baydawi'
      assign dars_ar = 'تفسير البيضاوي'
    when 'AB-1348'
      assign dars_badge = 'Dars-e-Nizami · Grade 7 · Mishkat al-Masabih'
      assign dars_ar = 'مشكاة المصابيح'
    when 'AB-1352'
      assign dars_badge = 'Dars-e-Nizami · Grade 7 · A’inah-e-Qadianiyyat'
      assign dars_ar = 'آئینہ قادیانیت'
    when 'AB-1244', 'AB-1153'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 (Dawrah-e-Hadith) · Sahih al-Bukhari'
      assign dars_ar = 'صحيح البخاري'
    when 'AB-1329'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 (Dawrah-e-Hadith) · Sahih Muslim'
      assign dars_ar = 'صحيح مسلم'
    when 'AB-1236'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 (Dawrah-e-Hadith) · Sunan Ibn Majah'
      assign dars_ar = 'سنن ابن ماجه'
    when 'AB-1335'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 (Dawrah-e-Hadith) · Jami’ al-Tirmidhi'
      assign dars_ar = 'جامع الترمذي'
    when 'AB-1332', 'AB-1338'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 (Dawrah-e-Hadith) · Sunan Abi Dawud'
      assign dars_ar = 'سنن أبي داود'
    when 'AB-1069', 'AB-1342'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 · Sharh al-Aqidah al-Tahawiyyah'
      assign dars_ar = 'شرح العقيدة الطحاوية'
    when 'AB-1278'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 · Sharh Ma’ani al-Athar — Vol. 1'
      assign dars_ar = 'شرح معاني الآثار'
    when 'AB-1239'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 · Muwatta al-Imam Malik'
      assign dars_ar = 'موطأ الإمام مالك'
    when 'AB-1349'
      assign dars_badge = 'Dars-e-Nizami · Grade 8 · Muwatta al-Imam Muhammad'
      assign dars_ar = 'موطأ الإمام محمد'
  endcase

  if dars_badge == ''
    for t in product.tags
      if t contains 'Grade' or t contains 'Dars'
        assign dars_badge = t
        break
      endif
    endfor
  endif

  comment
    Infer Language & Binding from product tags/title/vendor
  endcomment
  assign book_lang = product.metafields.custom.language | default: 'Arabic / Urdu Classical Edition'
  for t in product.tags
    assign t_down = t | downcase
    if t_down contains 'arabic' and t_down contains 'urdu'
      assign book_lang = 'Arabic & Urdu Bilingual'
    elsif t_down contains 'english'
      assign book_lang = 'English & Arabic Scholarly Edition'
    elsif t_down contains 'urdu'
      assign book_lang = 'Urdu'
    elsif t_down contains 'arabic'
      assign book_lang = 'Classical Arabic (Vocalized)'
    elsif t_down contains 'persian'
      assign book_lang = 'Persian / Arabic'
    endif
  endfor

  assign book_binding = product.metafields.custom.binding | default: 'Archival Hardcover / Chamois Cream Paper'
  if current_variant.weight > 0
    assign weight_kg = current_variant.weight_in_unit | append: ' ' | append: current_variant.weight_unit
  else
    assign weight_kg = 'Standard Archival Dispatch'
  endif
-%}

<section class="ab-pdp-shell" id="AbScholarlyProduct-{{ section.id }}">
  <div class="ab-pdp-breadcrumbs">
    <a href="{{ routes.root_url }}">← Aalimbooks International</a>
    <span class="ab-pdp-crumb-sep">·</span>
    {% if product.type != blank %}
      <a href="{{ routes.collections_url }}/all">{{ product.type }}</a>
    {% else %}
      <a href="{{ routes.all_products_collection_url }}">Classical Library Catalog</a>
    {% endif %}
    <span class="ab-pdp-crumb-right">
      <a href="#KutubLinkEbooks">📖 Free Open-Access E-Books</a>
      <span>·</span>
      <a href="https://github.com/khurramcr7/KutubLink" target="_blank" rel="noopener">KutubLink GitHub Repo ↗</a>
    </span>
  </div>

  <div class="ab-pdp-grid">
    <!-- Left Column: Warm Ivory Editorial Book Stage & Look-Inside Spread Gallery -->
    <div class="ab-pdp-gallery-col">
      <div class="ab-pdp-stage" id="AbMainStage-{{ section.id }}">
        <div class="ab-pdp-stage-badge">
          <span>✦ Scholarly Archival Edition</span>
          {% if product.images.size > 1 %}
            <small>{{ product.images.size }} Spreads Available</small>
          {% endif %}
        </div>

        {% if product.featured_image %}
          <button type="button" class="ab-pdp-zoom-trigger" id="AbZoomTrigger-{{ section.id }}" aria-label="Zoom book cover and interior spreads">
            <img
              id="AbActiveImage-{{ section.id }}"
              src="{{ product.featured_image | image_url: width: 1200 }}"
              alt="{{ product.title | escape }}"
              width="900"
              height="1150"
              fetchpriority="high"
            >
            <span class="ab-pdp-zoom-pill">🔍 High-Res Look Inside / Zoom</span>
          </button>
        {% else %}
          <div class="ab-pdp-fallback-cover" lang="ar" dir="rtl">
            <span>{{ title_ar | default: product.title }}</span>
            <small>{{ product.vendor }}</small>
          </div>
        {% endif %}
      </div>

      {% if product.images.size > 1 %}
        <div class="ab-pdp-thumbs-wrap">
          <p class="ab-pdp-thumbs-label">Look Inside · Cover &amp; Interior Page Spreads (01–0{{ product.images.size }})</p>
          <div class="ab-pdp-thumbs" role="list">
            {% for image in product.images %}
              <button
                type="button"
                class="ab-pdp-thumb {% if forloop.first %}is-active{% endif %}"
                data-full-src="{{ image | image_url: width: 1600 }}"
                data-stage-src="{{ image | image_url: width: 1200 }}"
                data-spread-index="{{ forloop.index }}"
                aria-label="View spread {{ forloop.index }}"
              >
                <img src="{{ image | image_url: width: 220 }}" alt="{{ product.title | escape }} — Spread {{ forloop.index }}" loading="lazy" width="90" height="116">
                <span>0{{ forloop.index }}</span>
              </button>
            {% endfor %}
          </div>
        </div>
      {% else %}
        <div class="ab-pdp-thumbs-wrap">
          <div class="ab-pdp-spread-note">
            <span>📜 Verified Physical Edition</span>
            <small>Two-color / high-contrast classical typesetting · Inspected by Aalimbooks &amp; KutubLink</small>
          </div>
        </div>
      {% endif %}
    </div>

    <!-- Right Column: Scholarly Typography, Curriculum Badge, Purchase Box & Bibliographic Ledger -->
    <div class="ab-pdp-copy-col">
      <p class="ab-pdp-eyebrow">
        <span class="ab-pdp-dot"></span>
        {{ product.vendor | default: 'Maktaba Al-Bushra · Classical Edition' }}
        {% if sku != blank %}
          <small>· SKU {{ sku }}</small>
        {% endif %}
      </p>

      {% if dars_badge != blank %}
        <div class="ab-pdp-curriculum-badge">
          <span>🎓 {{ dars_badge }}</span>
          {% if dars_ar != blank %}
            <strong lang="ar" dir="rtl">{{ dars_ar }}</strong>
          {% endif %}
        </div>
      {% else %}
        <div class="ab-pdp-curriculum-badge is-general">
          <span>🏛️ Classical Islamic Scholarship · Verified Print Edition</span>
        </div>
      {% endif %}

      <h1 class="ab-pdp-title-en">{{ title_en }}</h1>

      {% if title_ar != blank %}
        <h2 class="ab-pdp-title-ar" lang="ar" dir="rtl">{{ title_ar }}</h2>
      {% endif %}

      {% if product.metafields.custom.author != blank %}
        <p class="ab-pdp-author">By {{ product.metafields.custom.author }}</p>
      {% endif %}

      <div class="ab-pdp-price-row">
        <div>
          <strong class="ab-pdp-price" id="AbPrice-{{ section.id }}">{{ current_variant.price | money_with_currency }}</strong>
          {% if current_variant.compare_at_price > current_variant.compare_at_price %}
            <s class="ab-pdp-compare">{{ current_variant.compare_at_price | money }}</s>
          {% endif %}
        </div>
        <small>Archival print edition · Dispatched globally via tracked DHL Express</small>
      </div>

      {% form 'product', product, class: 'ab-pdp-form' %}
        {% unless product.has_only_default_variant %}
          <div class="ab-pdp-variants">
            <label for="AbVariantSelect-{{ section.id }}">Select Edition / Volume Variant</label>
            <select name="id" id="AbVariantSelect-{{ section.id }}" class="ab-pdp-select">
              {% for variant in product.variants %}
                <option
                  value="{{ variant.id }}"
                  {% if variant == current_variant %}selected="selected"{% endif %}
                  {% unless variant.available %}disabled="disabled"{% endunless %}
                >
                  {{ variant.title }} — {{ variant.price | money }} {% unless variant.available %}(Sold Out){% endunless %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endunless %}

        <div class="ab-pdp-qty-actions">
          <div class="ab-pdp-qty">
            <label for="AbQty-{{ section.id }}">Qty</label>
            <input type="number" id="AbQty-{{ section.id }}" name="quantity" value="1" min="1" max="50">
          </div>
          <button
            type="submit"
            name="add"
            class="ab-pdp-btn-primary"
            {% unless current_variant.available %}disabled{% endunless %}
          >
            {% if current_variant.available %}
              Add Print Edition to Bag
            {% else %}
              Currently Out of Stock
            {% endif %}
          </button>
        </div>

        <div class="ab-pdp-express">
          {{ form | payment_button }}
        </div>
      {% endform %}

      <div class="ab-pdp-ebook-callout">
        <div>
          <small>OPEN-ACCESS COMPANION ARCHIVE · KUTUBLINK</small>
          <strong>Read &amp; Download Free Bilingual Classical E-Books</strong>
          <p>Access our vocalized Arabic-English translated works &amp; structured bibliographic metadata for free.</p>
        </div>
        <div class="ab-pdp-ebook-links">
          <a href="#KutubLinkEbooks" class="ab-pdp-ebook-btn">📖 Open Free E-Book Reader</a>
          <a href="https://github.com/khurramcr7/KutubLink" target="_blank" rel="noopener" class="ab-pdp-git-btn">⚡ GitHub Repo (KutubLink) ↗</a>
        </div>
      </div>

      <!-- Structured Bibliographic & Physical Specification Ledger -->
      <div class="ab-pdp-ledger-wrap">
        <div class="ab-pdp-ledger-head">
          <h3>Bibliographic &amp; Physical Specifications</h3>
          <span lang="ar" dir="rtl">البيانات الببليوغرافية والمواصفات الفنية</span>
        </div>
        <dl class="ab-pdp-ledger">
          <div>
            <dt>Catalog SKU</dt>
            <dd>{{ sku | default: 'AB-VERIFIED' }}</dd>
          </div>
          <div>
            <dt>Publisher / Imprint</dt>
            <dd>{{ product.vendor | default: 'Maktaba Al-Bushra' }}</dd>
          </div>
          <div>
            <dt>Subject Classification</dt>
            <dd>{{ product.type | default: 'Classical Islamic Sciences (Dars-e-Nizami)' }}</dd>
          </div>
          <div>
            <dt>Language &amp; Script</dt>
            <dd>{{ book_lang }}</dd>
          </div>
          {% if dars_badge != blank %}
            <div>
              <dt>Seminary Syllabus</dt>
              <dd>{{ dars_badge }}</dd>
            </div>
          {% endif %}
          <div>
            <dt>Paper &amp; Binding</dt>
            <dd>{{ book_binding }}</dd>
          </div>
          <div>
            <dt>Dispatch Weight</dt>
            <dd>{{ weight_kg }}</dd>
          </div>
          <div>
            <dt>Fulfilment &amp; Courier</dt>
            <dd>Aalimbooks Central Warehouse · DHL Express Worldwide</dd>
          </div>
          <div>
            <dt>Verification Protocol</dt>
            <dd><a href="https://github.com/khurramcr7/KutubLink" target="_blank" rel="noopener">KutubLink &amp; AQL zeroH Verified ↗</a></dd>
          </div>
        </dl>
      </div>

      {% if product.description != blank %}
        <div class="ab-pdp-description">
          <h3>About This Scholarly Edition</h3>
          <div class="ab-pdp-rte">{{ product.description }}</div>
        </div>
      {% else %}
        <div class="ab-pdp-description">
          <h3>About This Scholarly Edition</h3>
          <p>
            Published by <strong>{{ product.vendor | default: 'Maktaba Al-Bushra' }}</strong> and curated by <strong>Aalimbooks International</strong> for scholars, seminary students, and institutional libraries. Typeset with high-contrast vocalized Arabic/Urdu script on archival cream paper to minimize eye strain during extended study.
          </p>
        </div>
      {% endif %}

      <div class="ab-pdp-stock-pill">
        {% if current_variant.available %}
          ● In Stock · Authenticated Physical Edition · Ready for International DHL Dispatch
        {% else %}
          ○ Currently Awaiting Restock from Publisher Warehouse
        {% endif %}
      </div>
    </div>
  </div>

  <!-- High-Res Lightbox Modal -->
  {% if product.featured_image %}
    <div class="ab-pdp-lightbox" id="AbLightbox-{{ section.id }}" hidden>
      <div class="ab-pdp-lightbox-card">
        <button type="button" class="ab-pdp-lightbox-close" id="AbLightboxClose-{{ section.id }}" aria-label="Close zoom view">×</button>
        <div class="ab-pdp-lightbox-img-wrap">
          <img id="AbLightboxImg-{{ section.id }}" src="{{ product.featured_image | image_url: width: 1600 }}" alt="{{ product.title | escape }}">
        </div>
      </div>
    </div>
  {% endif %}
</section>

<script>
  (function () {
    var root = document.getElementById('AbScholarlyProduct-{{ section.id }}');
    if (!root) return;
    var activeImg = document.getElementById('AbActiveImage-{{ section.id }}');
    var lightbox = document.getElementById('AbLightbox-{{ section.id }}');
    var lightboxImg = document.getElementById('AbLightboxImg-{{ section.id }}');
    var zoomTrigger = document.getElementById('AbZoomTrigger-{{ section.id }}');
    var closeBtn = document.getElementById('AbLightboxClose-{{ section.id }}');

    root.querySelectorAll('.ab-pdp-thumb').forEach(function (thumb) {
      thumb.addEventListener('click', function () {
        var stageSrc = thumb.getAttribute('data-stage-src');
        var fullSrc = thumb.getAttribute('data-full-src');
        if (activeImg && stageSrc) activeImg.src = stageSrc;
        if (lightboxImg && fullSrc) lightboxImg.src = fullSrc;
        root.querySelectorAll('.ab-pdp-thumb').forEach(function (t) { t.classList.remove('is-active'); });
        thumb.classList.add('is-active');
      });
    });

    if (zoomTrigger && lightbox) {
      zoomTrigger.addEventListener('click', function () {
        lightbox.hidden = false;
      });
    }
    if (closeBtn && lightbox) {
      closeBtn.addEventListener('click', function () {
        lightbox.hidden = true;
      });
      lightbox.addEventListener('click', function (e) {
        if (e.target === lightbox) lightbox.hidden = true;
      });
    }
  })();
</script>

{% stylesheet %}
  .ab-pdp-shell {
    --ink: #241e19;
