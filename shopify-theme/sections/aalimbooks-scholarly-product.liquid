  }
  .ab-pdp-fallback-cover span {
    font-family: 'Amiri', Georgia, serif;
    font-size: 34px;
    line-height: 1.4;
  }
  .ab-pdp-thumbs-wrap {
    margin-top: 14px;
  }
  .ab-pdp-thumbs-label {
    margin: 0 0 8px;
    font-size: 10px;
    font-weight: 800;
